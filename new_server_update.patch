+    display: flex;
+    align-items: center;
+    gap: 6px;
+    background: rgba(255, 255, 255, 0.1);
+    border: none;
+    padding: 8px 12px;
+    border-radius: 10px;
+    color: var(--text-main, #fff);
+    font-size: 13px;
+    font-weight: 600;
+    cursor: pointer;
+    transition: all 0.3s ease;
+}
+
+.view-order-btn:hover {
+    background: rgba(255, 255, 255, 0.15);
+}
+
+.view-order-btn svg {
+    transition: transform 0.3s ease;
+}
+
+.view-order-btn svg.rotated {
+    transform: rotate(180deg);
+}
+
+.order-tracking-container {
+    margin-top: 20px;
+    padding-top: 20px;
+    border-top: 1px dashed var(--border-color, #2C2C2E);
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+}
+
