+Subject: [PATCH 3/5] fix: html parsing on accept and delete message on reject
+
+---
+ punyo_go_bot/handlers/orders.py | 21 +++++----------------
+ 1 file changed, 5 insertions(+), 16 deletions(-)
+
+diff --git a/punyo_go_bot/handlers/orders.py b/punyo_go_bot/handlers/orders.py
+index 2098ea0..fc460ca 100644
+--- a/punyo_go_bot/handlers/orders.py
++++ b/punyo_go_bot/handlers/orders.py
+@@ -129,7 +129,7 @@ async def handle_accept_order(callback: CallbackQuery):
+     ])
+     
+     try:
+-        await callback.message.edit_text(new_text, reply_markup=keyboard)
