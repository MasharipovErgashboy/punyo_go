+     except Exception as e:
+         print(f"Error editing message: {e}")
+         
+@@ -147,21 +147,10 @@ async def handle_reject_order(callback: CallbackQuery):
+         await callback.answer("Xatolik yuz berdi!", show_alert=True)
+         return
